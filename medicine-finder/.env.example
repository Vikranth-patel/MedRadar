# Copy this file to ".env" and edit. NEVER commit ".env" (it is in .gitignore).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medradar
DB_USER=root
DB_PASS=root
# Random secret used to hash IPs / rate-limit keys. Change it!
APP_KEY=change-me-to-a-long-random-string
# Freshness + request policy (see README "Documented policies")
FRESH_HOURS=24
REQUEST_TTL_HOURS=4
SESSION_IDLE_MINUTES=30
